# EC2: cp .env.prod.example .env.prod 후 값 채우기. git 커밋 금지.
POSTGRES_PASSWORD=change-me-strong
JWT_SECRET=change-me-long-random

# Flutter 웹 origin (mall.anoveli.com — 아노벨리 app.anoveli.com 과 분리)
CORS_ORIGINS=https://mall.anoveli.com

ALLOW_DB_RESET=false
ADMIN_EMAIL=admin@mall.local
ADMIN_PASSWORD=change-me-admin

SIGNUP_CREDIT_BONUS=100
LOG_LEVEL=INFO
LOG_FORMAT=json
