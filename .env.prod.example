# EC2: cp .env.prod.example .env.prod 후 값 채우기. git 커밋 금지.
POSTGRES_PASSWORD=change-me-strong
JWT_SECRET=change-me-long-random
# 주문서형·결제창형 연동 키(test_gck_ / test_gsk_). API 개별 연동(test_ck_ / test_sk_)은 결제창(구버전)이라 사용하지 않는다.
TOSS_CLIENT_KEY=test_gck_replace-me
TOSS_SECRET_KEY=test_gsk_replace-me
TOSS_API_TIMEOUT=10

# Flutter 웹 origin (mall.anoveli.com — 아노벨리 app.anoveli.com 과 분리)
CORS_ORIGINS=https://mall.anoveli.com

ALLOW_DB_RESET=false
ADMIN_EMAIL=admin@mall.local
ADMIN_PASSWORD=change-me-admin

SIGNUP_CREDIT_BONUS=100
LOG_LEVEL=INFO
LOG_FORMAT=json
