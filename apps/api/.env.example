# Copy to .env and adjust as needed
DATABASE_URL=postgresql+psycopg://mall:mall@localhost:5434/mall
# SQLAlchemy pool (MVP 기준선 — docs/load-baseline.md)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
REDIS_URL=redis://localhost:6380
JWT_SECRET=dev-secret-change-in-production
# 주문서형·결제창형 연동 키(test_gck_ / test_gsk_). API 개별 연동(test_ck_ / test_sk_)은 결제창(구버전)이라 사용하지 않는다.
TOSS_CLIENT_KEY=test_gck_replace-me
TOSS_SECRET_KEY=test_gsk_replace-me
TOSS_API_TIMEOUT=10
# Comma-separated browser origins (Flutter web, etc.)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Global admin (created on startup / seed if not exists)
ADMIN_EMAIL=admin@mall.local
ADMIN_PASSWORD=admin-dev-only

# Allow destructive DB reset via POST /admin/db/reset (dev only)
ALLOW_DB_RESET=true

# Credits remain for legacy wallets; public checkout uses Toss (KRW).
SIGNUP_CREDIT_BONUS=100
