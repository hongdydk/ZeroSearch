# Copy to .env and adjust as needed
DATABASE_URL=postgresql+psycopg://mall:mall@localhost:5434/mall
# SQLAlchemy pool (MVP 기준선 — docs/load-baseline.md)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
REDIS_URL=redis://localhost:6380
JWT_SECRET=dev-secret-change-in-production
# Comma-separated browser origins (Flutter web, etc.)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Global admin (created on startup / seed if not exists)
ADMIN_EMAIL=admin@mall.local
ADMIN_PASSWORD=admin-dev-only

# Allow destructive DB reset via POST /admin/db/reset (dev only)
ALLOW_DB_RESET=true

# Credits (stub checkout — no real payment in Phase 1)
SIGNUP_CREDIT_BONUS=100
