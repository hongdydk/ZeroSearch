{
  "name": "Zero Search (제로 서치)",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd apps/api && ./.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8001 --reload"
    }
  ],
  "ports": [
    { "name": "API (FastAPI)", "port": 8001 }
  ]
}
